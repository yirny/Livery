# BuildInfo.cmake: writes BuildInfo.h with the version and the git state the build came from,
# so Livery.log names the build that is running (a worktree's or a branch's build is told apart).
#
# Run on every build by the build_info target in CMakeLists.txt:
#   cmake -DOUTPUT=<header> -DVERSION=<x.y.z> -DSOURCE_DIR=<repo> -P cmake/BuildInfo.cmake
# The header is rewritten only when its text changes, so an unchanged state recompiles nothing.

set(describe "unknown")
set(branch "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" describe --tags --always --dirty
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE git_describe
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE describe_result)
    if(describe_result EQUAL 0 AND git_describe)
        set(describe "${git_describe}")
    endif()
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --abbrev-ref HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE git_branch
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE branch_result)
    if(branch_result EQUAL 0 AND git_branch)
        set(branch "${git_branch}")
    endif()
endif()

set(text "// Generated by cmake/BuildInfo.cmake on every build; do not edit.
#pragma once

#define LIVERY_VERSION \"${VERSION}\"
#define LIVERY_BUILD_DESCRIBE \"${describe}\"
#define LIVERY_BUILD_BRANCH \"${branch}\"
")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old_text)
else()
    set(old_text "")
endif()
if(NOT old_text STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
